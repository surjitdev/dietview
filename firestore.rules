rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable core gates
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation schemas
    function isNum(val) {
      return val is int || val is float;
    }

    function isValidUserGoal(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.email is string && data.email.size() <= 128;
    }

    function isValidFoodLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.foodName is string && data.foodName.size() <= 128
        && isNum(data.calories) && data.calories >= 0
        && isNum(data.protein) && data.protein >= 0
        && isNum(data.carbs) && data.carbs >= 0
        && isNum(data.fats) && data.fats >= 0
        && data.mealType is string && data.mealType.size() <= 64
        && data.date is string && data.date.size() <= 32
        && (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidSharedPost(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && (data.userName is string && data.userName.size() <= 128)
        && (!('userPhoto' in data) || data.userPhoto is string || data.userPhoto == null)
        && data.text is string && data.text.size() <= 1000
        && (!('mealDetails' in data) || data.mealDetails is string)
        && (!('calories' in data) || isNum(data.calories))
        && (!('protein' in data) || isNum(data.protein))
        && (!('carbs' in data) || isNum(data.carbs))
        && data.privacy is string && (data.privacy == 'public' || data.privacy == 'private' || data.privacy == 'friends')
        && data.likes is list && data.likes.size() <= 1000
        && (!('timestamp' in data) || data.timestamp is timestamp || data.timestamp is string);
    }

    function isValidWaterLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.date is string && data.date.size() <= 32
        && isNum(data.amount) && data.amount >= 0 && data.amount <= 10000
        && (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidWeightLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.date is string && data.date.size() <= 32
        && isNum(data.weight) && data.weight >= 0 && data.weight <= 500
        && (!('createdAt' in data) || data.createdAt is string);
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ajdonna21@gmail.com';
    }

    function isValidUpiPayment(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 128
        && data.userName is string && data.userName.size() <= 128
        && data.planId is string && data.planId.size() <= 64
        && data.planName is string && data.planName.size() <= 128
        && isNum(data.price) && data.price >= 0
        && data.currency is string && data.currency.size() <= 16
        && data.transactionId is string && data.transactionId.size() <= 128
        && data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Match blocks
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserGoal(incoming()) && (
        !('isPremium' in incoming()) || incoming().isPremium == false
      );
      allow update: if (isOwner(userId) && isValidUserGoal(incoming())
        && (!('isPremium' in incoming()) || !('isPremium' in existing()) || incoming().isPremium == existing().isPremium || incoming().isPremium == false)
        && (!('trialActive' in incoming()) || !('trialActive' in existing()) || incoming().trialActive == existing().trialActive || incoming().trialActive == false)
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /foodLogs/{logId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidFoodLog(incoming());
        allow update: if isOwner(userId) && isValidId(logId) && isValidFoodLog(incoming())
          && incoming().id == existing().id
          && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      match /waterLogs/{logId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidWaterLog(incoming());
        allow update: if isOwner(userId) && isValidId(logId) && isValidWaterLog(incoming())
          && incoming().id == existing().id
          && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      match /weightLogs/{logId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidWeightLog(incoming());
        allow update: if isOwner(userId) && isValidId(logId) && isValidWeightLog(incoming())
          && incoming().id == existing().id
          && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && (existing().privacy == 'public' || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.privacy == 'public' || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(postId) && isValidSharedPost(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(postId) && isValidSharedPost(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && (
          (incoming().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'privacy', 'mealDetails', 'calories', 'protein', 'carbs']))
          ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['likes']))
        );
      allow delete: if isSignedIn() && isValidId(postId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /upiPayments/{paymentId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(paymentId) && incoming().userId == request.auth.uid && isValidUpiPayment(incoming()) && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(paymentId) && (
        (incoming().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['transactionId', 'updatedAt']) && isValidUpiPayment(incoming()))
        ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && isValidUpiPayment(incoming()))
      );
      allow delete: if isAdmin();
    }
  }
}
